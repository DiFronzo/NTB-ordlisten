{
  "tasks": {
    "dev": "deno run --allow-net --allow-read --watch main.ts",
    "check": "deno check main.ts",
    "test": "deno test --allow-read tests/",
    "lint": "deno lint"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/http": "jsr:@std/http@^1.0.25"
  },
  "compilerOptions": {
    "strict": true
  },
  "lint": {
    "include": ["src/", "tests/", "main.ts"]
  }
}
